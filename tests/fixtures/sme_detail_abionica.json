{"html":"\r\n\u003cdiv id=\"CustomValSummary\" class=\"formValidation\" style=\"width: 100%; height: auto; padding-top: 15px;\"\u003e\r\n        \r\n\u003c/div\u003e\r\n\r\n\u003cinput name=\"__RequestVerificationToken\" type=\"hidden\" value=\"tHr7wEV1JXwCB-UQM9s0lTj8FpKMRgrWzqJ8fVrGrsUYV2NIqChZWotcfekv8NaBD2RGQU2msl7pVvtxOvRh13Z8unKgYAOicXKKYLpr0Hk1\" /\u003e\r\n\u003cinput data-val=\"true\" data-val-number=\"The field EntityId must be a number.\" id=\"EntityId\" name=\"EntityId\" type=\"hidden\" value=\"79981\" /\u003e\r\n\u003cdiv class=\"formTableLarge\"\u003e\r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"Name\"\u003eName\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"Name\" name=\"Name\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"ABIONICA SOLUTIONS, S.L.P.\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"formEditInputContainerLast\"\u003e\r\n            \u003clabel for=\"NationalityDesc\"\u003eCountry of Registration\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"NationalityDesc\" name=\"NationalityDesc\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"ES-Spain\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"EntityCode\"\u003eEntity Code\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntityCode\" name=\"EntityCode\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"1000048110\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"formEditInputContainerLast\"\u003e\r\n            \u003clabel for=\"EntityVatNumber\"\u003eVAT Number\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntityVatNumber\" name=\"EntityVatNumber\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"ESB42575233\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n     \u003cdiv class=\"formRowEdit\"  \u003e     \r\n        \u003cdiv class=\"formEditInputContainer\" \u003e\r\n            \u003clabel for=\"EntitySMEStatus\"\u003eSME Status\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntitySMEStatus\" name=\"EntitySMEStatus\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"Yes\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"formRowEdit\"  \u003e\r\n        \u003cdiv class=\"\"   \u003e\r\n            \u003clabel for=\"Description\"\u003eEntity Description in English\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003ctextarea class=\"kendo\" cols=\"100\" id=\"Description\" name=\"Description\" rows=\"5\" style=\"display: block; width: 100%; resize: none;\"\u003e\r\nConsultancy firm dedicated to aeroespace engeneering, specialited in unmaned aerial systems.\u0026lt;br\u0026gt;\u003c/textarea\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"EntityTypeDesc\"\u003eEntity Type\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntityTypeDesc\" name=\"EntityTypeDesc\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"Company\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"formEditInputContainerLast\"\u003e\r\n            \u003clabel for=\"EntitySizeDesc\"\u003eEntity Size\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntitySizeDesc\" name=\"EntitySizeDesc\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"TBD\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"Address\"\u003eAddress\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"Address\" name=\"Address\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"CALLE ENRIC VALOR \" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"formEditInputContainerLast\"\u003e\r\n            \u003clabel for=\"Number\"\u003eHouse Number\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"Number\" name=\"Number\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"2\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"City\"\u003eCity\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"City\" name=\"City\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"ALICANTE\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"formEditInputContainerLast\"\u003e\r\n            \u003clabel for=\"PostalCode\"\u003ePostal Code\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"PostalCode\" name=\"PostalCode\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"03540\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n     \r\n    \u003cdiv class=\"formRowEdit\"\u003e\r\n        \r\n        \u003cdiv class=\"formEditInputContainer\"\u003e\r\n            \u003clabel for=\"EntityWebSite\"\u003eWeb Site\u003c/label\u003e\r\n            \u003cdiv class=\"formEditInput\"\u003e\r\n                \u003cinput disabled=\"disabled\" id=\"EntityWebSite\" name=\"EntityWebSite\" readonly=\"readonly\" style=\"display: inline; width: 27em;\" type=\"text\" value=\"\" /\u003e\r\n                \u003cspan class=\"formValidationPopup\"\u003e\u003c/span\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n\u003cscript\u003e\r\n\r\n     //init page objects at document ready\r\n    $(function () {\r\n       //************ Kendo texteditor settings \r\n        $(\"#Description\").kendoEditor(\r\n            {\r\n                tools: [],\r\n            }\r\n        );\r\n        var editor = $(\"#Description\").data(\"kendoEditor\"),\r\n            editorBody = $(editor.body);\r\n\r\n        // Make the Editor read-only.\r\n        editorBody.removeAttr(\"contenteditable\").find(\"a\").on(\"click.readonly\", false);\r\n\r\n        \r\n        EnableFileActions(\"fileUploadPath\", \"fileDownload\", null);\r\n\r\n        //init toolbar buttons\r\n        InitUiButton();\r\n    });\r\n\r\n\r\n\r\n\r\n\r\n\u003c/script\u003e\r\n\u003cstyle\u003e\r\n\r\n    .ui-dialog .ui-accordion-content {\r\n        border: 1px solid #dddddd;\r\n        border-top: 0;\r\n    }\r\n\u003c/style\u003e","addBuRegistrationButton":false,"Success":true}