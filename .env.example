# ESA Scout configuration
#
# Copy to `.env` and fill in what you need. Every value is optional: the agent
# degrades gracefully, so with an empty file it will still scrape and render the
# dashboard — just without AI scoring or notifications.
#
#   cp .env.example .env

# ─── AI evaluation ──────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Without LLM_API_KEY the pipeline runs but
# opportunities are left unscored.
LLM_API_KEY=
# xAI / Grok (default)
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4
# OpenRouter:  https://openrouter.ai/api/v1        · e.g. anthropic/claude-sonnet-4
# Groq:        https://api.groq.com/openai/v1      · e.g. llama-3.3-70b-versatile
# OpenAI:      https://api.openai.com/v1           · e.g. gpt-4o-mini
# Local:       http://localhost:11434/v1           · e.g. llama3

# Sampling temperature; low keeps scores stable between runs.
LLM_TEMPERATURE=0.2
# Safety valve on cost: maximum opportunities evaluated per run. Cached
# evaluations are free, so this only bounds genuinely new or changed entries.
LLM_MAX_OPPORTUNITIES=60

# ─── Profile context ────────────────────────────────────────────────────────
# Your public GitHub username. Repositories are used to judge current skills.
GITHUB_USERNAME=
# Optional: raises the GitHub API rate limit from 60/h to 5000/h.
GITHUB_TOKEN=

# The CV is auto-detected: any PDF in the repository root or agent/profile/.
# Files whose name contains cv / resume / profile are preferred.

# ─── Notifications ──────────────────────────────────────────────────────────
# Alerts fire only when an opportunity changes status (e.g. Pending -> Open) or
# when a newly listed OPEN opportunity scores at or above NOTIFY_MATCH_THRESHOLD.
# The first run never notifies, to avoid an alert storm on setup.

# Email — option A: Resend (recommended, simplest)
RESEND_API_KEY=
EMAIL_FROM=ESA Scout <scout@your-domain.dev>
EMAIL_TO=you@example.com

# Email — option B: any SMTP server (used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Telegram: create a bot with @BotFather, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Print notifications instead of sending them — useful while testing.
NOTIFY_DRY_RUN=false

# ─── Behaviour ──────────────────────────────────────────────────────────────
# Minimum match score for a newly listed open opportunity to trigger an alert.
NOTIFY_MATCH_THRESHOLD=70
# Score at or above which the dashboard counts an opportunity as "high fit".
HIGH_FIT_THRESHOLD=80
# Comma-separated keywords selecting relevant jobs.esa.int postings.
JOB_KEYWORDS=internship,young graduate,graduate trainee,student
# Result pages to walk on the careers portal (25 postings per page).
MAX_JOB_PAGES=4
# Link included in notifications so you can jump straight to the dashboard.
DASHBOARD_URL=

# ─── SME Internship Matcher (Spain & Italy) ─────────────────────────────────
# Scans the ESA-star public supplier directory for space-sector SMEs and ranks
# them as speculative internship targets:  python -m agent.main sme --evaluate

# Countries to scan, by their ESA-star name. Case matters — these are sent
# verbatim as the directory's server-side filter value.
SME_COUNTRIES=Spain,Italy
# Relevance taxonomy. A company must mention at least one of these (or a close
# alias) to be kept; the matches also become the domain tags shown on each card.
SME_KEYWORDS=earth observation,remote sensing,artificial intelligence,machine learning,data processing,software,computer vision,gis,satellite data
# The internship the AI is asked to assess each company for.
SME_TARGET_TERM=Summer 2027
# Directory pages to walk per country (20 companies per page). The default is
# well above the real page count and exists only as a runaway guard.
SME_MAX_PAGES=40
# Concurrent workers for the ~600 company detail lookups. Be polite: ESA-star is
# a public service and 6 keeps the full scan under a minute.
SME_DETAIL_WORKERS=6
# Safety valve on cost: maximum companies ranked by the LLM per run. Cached
# rankings are free, so this only bounds genuinely new or changed companies.
# The most relevant companies (most keyword matches) are ranked first.
SME_MAX_EVALUATIONS=40
# Score at or above which a company is badged "Strong fit".
SME_STRONG_FIT_THRESHOLD=70

# ─── Networking ─────────────────────────────────────────────────────────────
HTTP_TIMEOUT=45
HTTP_MAX_RETRIES=3
# Route fetches through Scrapling's browser-backed fetcher. Requires the
# optional extras in requirements.txt (curl_cffi + playwright). Only needed if
# ESA starts serving these pages via JavaScript or adds bot protection.
SCRAPLING_FETCHER=false
# Skip writing the copy the Next.js app reads (web/public/data/).
SKIP_WEB_MIRROR=false

# ─── Dashboard (set these in Vercel, not here) ──────────────────────────────
# Enables the dashboard's "Sync now" button by dispatching the GitHub workflow.
# GITHUB_REPO=your-user/esa-scout
# GITHUB_DISPATCH_TOKEN=github_pat_...   # needs `actions: write`
# GITHUB_WORKFLOW_FILE=cron.yml
# GITHUB_SME_WORKFLOW=sme.yml            # used by the "Analyze best SME matches" button
# GITHUB_REF=main
# SYNC_SECRET=                            # if set, callers must send x-sync-secret
# LLM_API_KEY=                            # presence lets the SME scan button explain
#                                         # itself instead of running unranked
# PYTHON_BIN=python3                      # local dev only: interpreter for the
#                                         # on-demand scan (e.g. .venv/bin/python)
